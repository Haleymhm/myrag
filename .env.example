# PostgreSQL connection used by the Next.js app.
# Matches the credentials defined in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extracto

# OpenRouter API Key for Multimodal Vision Document Analysis (deepseek/deepseek-v4.1-flash)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini API Key 
GEMINI_API_KEY=
